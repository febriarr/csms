# Used by docker-compose.yml. Copy to `.env` and fill in. Every value below is a placeholder, never a real secret.
# (The backend and the web app have their own .env.example for running without Docker.)

# Where people open the dashboard
# Exactly what is typed in the browser's address bar, with no trailing slash. Use your https:// domain: the API sets
# secure cookies in production, and browsers only keep them on HTTPS (or on http://localhost).
PUBLIC_URL=https://csms.example.com
# The web container listens on this address and port of the host. 127.0.0.1 = only the reverse proxy on the same host
# can reach it. Use 0.0.0.0 to open it to the network (plain HTTP).
WEB_BIND=127.0.0.1
WEB_PORT=8080
# How many proxies sit between the browser and the API, counting the nginx inside the web container:
#   2 = your reverse proxy (Caddy, nginx, cloudflared) + that nginx   (default)
#   3 = Cloudflare proxy in front of your reverse proxy
#   1 = nobody in front: the web port is open to the network
# Too low and every user looks like the proxy and shares one rate limit. Too high and a client can fake its address.
TRUST_PROXY=2

# Database
POSTGRES_USER=csms
# Used inside a URL: use letters and digits only. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=csms

# Secrets
# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
# At least 16 characters. The key every device sends in the `x-device-key` header.
DEVICE_API_KEY=change-me-at-least-16-chars
# Password of the first super admin created by the seed command.
SEED_ADMIN_PASSWORD=ChangeMe123!

# Optional, these are the defaults
# THROTTLE_LIMIT=300
# THROTTLE_LOGIN_LIMIT=10
# WHATSAPP_ENABLED=false
