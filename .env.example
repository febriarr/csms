# Used by docker-compose.yml. Copy to `.env` and fill in. Every value below is a placeholder, never a real secret.
# (The backend and the web app have their own .env.example for running without Docker.)

# --- Where people open the dashboard -----------------------------------------------------------------------------
# Exactly what is typed in the browser's address bar, with no trailing slash.
# Use https:// in production: the API sets secure cookies when it runs in production mode.
PUBLIC_URL=http://localhost:8080
# Port the web container is published on.
WEB_PORT=8080

# --- Database ----------------------------------------------------------------------------------------------------
POSTGRES_USER=csms
# Used inside a URL: use letters and digits only. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=csms

# --- Secrets -----------------------------------------------------------------------------------------------------
# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
# At least 16 characters. The key every device sends in the `x-device-key` header.
DEVICE_API_KEY=change-me-at-least-16-chars
# Password of the first super admin created by the seed command.
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Optional, these are the defaults ----------------------------------------------------------------------------
# TRUST_PROXY=1
# THROTTLE_LIMIT=300
# THROTTLE_LOGIN_LIMIT=10
# WHATSAPP_ENABLED=false
