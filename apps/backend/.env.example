# Copy to `.env` and fill in. Every value below is a placeholder, never a real secret.
# The names and rules are checked at startup by src/config/env.validation.ts.

NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:password@localhost:5432/csms
DB_SSL=false
# Optional, these are the defaults:
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECTION_TIMEOUT_MS=5000
# DB_POOL_MAX_LIFETIME_SECONDS=1800
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_IDLE_IN_TX_TIMEOUT_MS=15000

# Web app and sign-in (Better Auth)
# Where the React app runs: the only origin allowed by CORS and by Better Auth.
WEB_URL=http://localhost:5173
# Where THIS API is reachable from the browser.
BETTER_AUTH_URL=http://localhost:3000
# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
# Only when the web app and the API live on different subdomains (e.g. .example.com). Leave empty otherwise.
AUTH_COOKIE_DOMAIN=
# Password of the first super admin created by `pnpm --filter backend db:seed`.
SEED_ADMIN_PASSWORD=ChangeMe123!

# Devices
# The key every device sends in the `x-device-key` header. At least 16 characters.
DEVICE_API_KEY=change-me-at-least-16-chars

# Rate limiting
# How many reverse proxies (nginx, Cloudflare, ...) sit between the user and the API. 0 = none.
# Too low behind a proxy: every user looks like the proxy and shares one limit.
# Too high without one: a user can fake their address and dodge the limit.
TRUST_PROXY=0
# Requests per minute and per client address, for the whole API (devices and /api/health are exempt).
THROTTLE_LIMIT=300
# Sign-in attempts per minute and per client address, right or wrong.
THROTTLE_LOGIN_LIMIT=10

# WhatsApp notifications
WHATSAPP_ENABLED=false
WHATSAPP_AUTH_DIR=.baileys_auth
