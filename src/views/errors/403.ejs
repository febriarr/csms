<div class="error-page">
  <ui5-icon name="message-warning" class="error-page__icon"></ui5-icon>
  <ui5-title level="H3"><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : '403 - Unauthorized' %></ui5-title>
  <ui5-text class="muted"><%= typeof pageDescription !== 'undefined' && pageDescription ? pageDescription : "You don't have permission to access this page." %></ui5-text>

  <div class="error-page__actions">
    <ui5-button design="Transparent" icon="navigation-left-arrow" data-href="<%= typeof currentPath !== 'undefined' && currentPath ? currentPath : '/dashboard' %>">Go Back</ui5-button>
    <ui5-button design="Emphasized" icon="home" data-href="/dashboard">Dashboard</ui5-button>
  </div>
</div>
