<form id="form-update-device" data-id="<%= data.id %>" style="max-width: 500px">
  <div class="field-group">
    <div class="field">
      <label for="name" class="field-label">Nama</label>
      <input
        type="text"
        id="name"
        name="name"
        placeholder="Nama Devices"
        required
        class="field-input"
        value="<%= data.name %>"
      />
    </div>
    <div class="field">
      <label for="code" class="field-label">Alias</label>
      <input
        type="text"
        id="code"
        name="code"
        placeholder="Kode unik device"
        required
        class="field-input"
        value="<%= data.code %>"
        disabled
      />
    </div>
    <div class="field">
      <label for="location" class="field-label">Lokasi</label>
      <input
        type="text"
        id="location"
        name="location"
        placeholder="Lokasi device"
        class="field-input"
        value="<%= data.location %>"
      />
    </div>

    <div class="field">
      <label for="defrostThreshold" class="field-label">Batas Suhu Defrost</label>
      <input
        type="number"
        id="defrostThreshold"
        name="defrostThreshold"
        step="0.01"
        placeholder="cth -18"
        required
        class="field-input"
        value="<%= data.defrostThreshold %>"
      />
    </div>

    <div class="field">
      <label for="warningThreshold" class="field-label">Batas Suhu Warning</label>
      <input
        type="number"
        id="warningThreshold"
        name="warningThreshold"
        step="0.01"
        placeholder="cth -5"
        required
        class="field-input"
        value="<%= data.warningThreshold %>"
      />
    </div>

    <div class="field">
      <label for="criticalThreshold" class="field-label">Batas Suhu Critical</label>
      <input
        type="number"
        id="criticalThreshold"
        name="criticalThreshold"
        step="0.01"
        placeholder="cth 0"
        required
        class="field-input"
        value="<%= data.criticalThreshold %>"
      />
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
  </div>
</form>
