<div class="dashboard-page-header"><div><p class="dashboard-page-eyebrow">Devices</p><h2>Update Device</h2><p>Maintain device identity and operational thresholds.</p></div></div>
<form id="form-update-device" data-id="<%= data.id %>" class="enterprise-form form-card"><div class="form-card__header"><h3 class="section-title"><%= data.name %></h3><p class="section-subtitle">Device code: <span class="device-code"><%= data.code %></span></p></div><div class="form-card__body"><div class="form-grid"><div class="field"><ui5-label for="name" required>Nama</ui5-label><ui5-input id="name" name="name" value="<%= data.name %>" required></ui5-input></div><div class="field"><ui5-label for="code" required>Alias</ui5-label><ui5-input id="code" name="code" value="<%= data.code %>" disabled></ui5-input></div><div class="field full"><ui5-label for="location">Lokasi</ui5-label><ui5-input id="location" name="location" value="<%= data.location %>"></ui5-input></div><div class="field"><ui5-label for="defrostThreshold" required>Batas Suhu Defrost</ui5-label><ui5-input id="defrostThreshold" name="defrostThreshold" type="Number" value="<%= data.defrostThreshold %>" required></ui5-input></div><div class="field"><ui5-label for="warningThreshold" required>Batas Suhu Warning</ui5-label><ui5-input id="warningThreshold" name="warningThreshold" type="Number" value="<%= data.warningThreshold %>" required></ui5-input></div><div class="field"><ui5-label for="criticalThreshold" required>Batas Suhu Critical</ui5-label><ui5-input id="criticalThreshold" name="criticalThreshold" type="Number" value="<%= data.criticalThreshold %>" required></ui5-input></div></div></div><div class="form-card__actions"><a href="/dashboard/devices" class="btn btn-outline">Cancel</a><ui5-button type="Submit" design="Emphasized">Update Device</ui5-button></div></form>
