<%
function buildPageUrl(page) {
  const params = new URLSearchParams({
    deviceId: device.id,
    from: filters.from || '',
    to: filters.to || '',
    page: page,
    pageSize: logs.pageSize,
  });

  return '/dashboard/reports/diagnostics/detail?' + params.toString();
}

function buildBackUrl() {
  const params = new URLSearchParams({
    deviceId: device.id,
    from: filters.from || '',
    to: filters.to || '',
  });

  return '/dashboard/reports/diagnostics?' + params.toString();
}

const resetReasonCodeLabel = {
  0: 'Unknown',
  1: 'Power On',
  2: 'External Pin',
  3: 'Software Restart',
  4: 'Panic',
  5: 'Interrupt Watchdog',
  6: 'Task Watchdog',
  7: 'Watchdog (RTC/Other)',
  8: 'Deep Sleep Wake',
  9: 'Brownout',
  10: 'SDIO',
};
%>


<div class="detail-page-header">

  <div>

    <h3>
      <%= device.name %>
      <span class="device-code">
        (<%= device.code %>)
      </span>
    </h3>

    <p class="muted-foreground">
      <%= filters.from %> &mdash; <%= filters.to %>
    </p>

  </div>


  <a
    href="<%= buildBackUrl() %>"
    class="btn btn-outline"
  >
    &larr; Back To Trend
  </a>

</div>


<% if (logs.items.length === 0) { %>

  <div class="section-body">

    <ui5-message-strip
      design="Information"
      hide-close-button
    >
      Tidak ada kejadian sensor/WiFi/HTTP gagal untuk device ini pada rentang tanggal ini.
    </ui5-message-strip>

  </div>

<% } else { %>


  <ui5-table
    class="enterprise-table "
    overflow-mode="Scroll"
    accessible-name="Diagnostic Logs"
    style="height: 600px;"
  >

    <ui5-table-header-row slot="headerRow" sticky>

      <ui5-table-header-cell min-width="max-content">
        Timestamp
      </ui5-table-header-cell>

      <ui5-table-header-cell min-width="max-content">
        Sensor Fail
      </ui5-table-header-cell>

      <ui5-table-header-cell min-width="max-content">
        WiFi Fail
      </ui5-table-header-cell>

      <ui5-table-header-cell min-width="max-content">
        HTTP Fail
      </ui5-table-header-cell>

      <ui5-table-header-cell min-width="max-content">
        RSSI
      </ui5-table-header-cell>

      <ui5-table-header-cell min-width="max-content">
        Reason Code
      </ui5-table-header-cell>

      <ui5-table-header-cell min-width="max-content">
        Reason
      </ui5-table-header-cell>

    </ui5-table-header-row>


    <% logs.items.forEach(item => { %>

      <ui5-table-row>

        <!-- Timestamp -->
        <ui5-table-cell>
          <%= formatDateTime(item.recordedAt) %>
        </ui5-table-cell>


        <!-- Sensor Fail -->
        <ui5-table-cell>
          <%= item.sensorFailCount %>
        </ui5-table-cell>


        <!-- WiFi Fail -->
        <ui5-table-cell>
          <%= item.wifiFailCount %>
        </ui5-table-cell>


        <!-- HTTP Fail -->
        <ui5-table-cell>
          <%= item.httpFailCount %>
        </ui5-table-cell>


        <!-- RSSI -->
        <ui5-table-cell>
          <%= item.rssi !== null ? item.rssi + ' dBm' : '—' %>
        </ui5-table-cell>


        <!-- Reason Code -->
        <ui5-table-cell>

          <% if (item.reason) { %>

            <span
              title="<%= resetReasonCodeLabel[item.reason.resetReasonCode] || 'Tidak diketahui' %>"
            >
              <%= item.reason.resetReasonCode %>

              <span class="muted-foreground">
                (
                <%= resetReasonCodeLabel[item.reason.resetReasonCode] || 'Unknown' %>
                )
              </span>
            </span>

          <% } else { %>

            —

          <% } %>

        </ui5-table-cell>


        <!-- Reason -->
        <ui5-table-cell>

          <% if (item.reason) { %>

            <ui5-tag
              design="<%= item.reason.resetReason === 'PANIC'
                ? 'Negative'
                : item.reason.resetReason === 'WATCHDOG'
                  ? 'Critical'
                  : item.reason.resetReason === 'BROWNOUT'
                    ? 'Critical'
                    : 'Neutral' %>"
            >
              <%= item.reason.resetReason %>
            </ui5-tag>

          <% } else { %>

            —

          <% } %>

        </ui5-table-cell>

      </ui5-table-row>

    <% }) %>

  </ui5-table>


  <div class="table-pagination">

    <span class="muted-foreground">
      Page
      <%= logs.page %>
      of
      <%= logs.totalPages %>
      (<%= logs.totalItems %> incidents)
    </span>


    <div class="page-actions">

      <% if (logs.page > 1) { %>

        <a
          href="<%= buildPageUrl(logs.page - 1) %>"
          class="btn btn-outline"
        >
          &larr; Prev
        </a>

      <% } %>


      <% if (logs.page < logs.totalPages) { %>

        <a
          href="<%= buildPageUrl(logs.page + 1) %>"
          class="btn btn-outline"
        >
          Next &rarr;
        </a>

      <% } %>

    </div>

  </div>

<% } %>