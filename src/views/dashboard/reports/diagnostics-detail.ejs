<%
function buildPageUrl(page) {
  const params = new URLSearchParams({
    deviceId: device.id,
    from: filters.from || '',
    to: filters.to || '',
    page: page,
    pageSize: logs.pageSize,
  });

  return '/dashboard/reports/diagnostics/detail?' + params.toString();
}

function buildBackUrl() {
  const params = new URLSearchParams({
    deviceId: device.id,
    from: filters.from || '',
    to: filters.to || '',
  });

  return '/dashboard/reports/diagnostics?' + params.toString();
}

const resetReasonCodeLabel = {
  0: 'Unknown',
  1: 'Power On',
  2: 'External Pin',
  3: 'Software Restart',
  4: 'Panic',
  5: 'Interrupt Watchdog',
  6: 'Task Watchdog',
  7: 'Watchdog (RTC/Other)',
  8: 'Deep Sleep Wake',
  9: 'Brownout',
  10: 'SDIO',
};
%>
<div class="stack">

  <div class="toolbar-row">
    <div class="cell-stack">
      <ui5-title level="H4"><%= device.name %> <ui5-text class="muted">(<%= device.code %>)</ui5-text></ui5-title>
      <ui5-text class="muted"><%= filters.from %> &mdash; <%= filters.to %></ui5-text>
    </div>

    <span class="toolbar-spacer"></span>

    <ui5-button design="Default" icon="navigation-left-arrow" data-href="<%= buildBackUrl() %>">Back To Trend</ui5-button>
  </div>

  <% if (logs.items.length === 0) { %>

    <ui5-message-strip design="Information" hide-close-button>
      Tidak ada kejadian sensor/WiFi/HTTP gagal untuk device ini pada rentang tanggal ini.
    </ui5-message-strip>

  <% } else { %>

    <div class="surface">
      <ui5-table class="table-tall" overflow-mode="Scroll" sticky-column-header accessible-name="Diagnostic Logs">
        <ui5-table-header-row slot="headerRow" sticky>
          <ui5-table-header-cell min-width="max-content">Timestamp</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Sensor Fail</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">WiFi Fail</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">HTTP Fail</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">RSSI</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Reason Code</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Reason</ui5-table-header-cell>
        </ui5-table-header-row>

        <% logs.items.forEach(item => { %>
          <ui5-table-row>
            <ui5-table-cell><ui5-text><%= formatDateTime(item.recordedAt) %></ui5-text></ui5-table-cell>
            <ui5-table-cell><ui5-text><%= item.sensorFailCount %></ui5-text></ui5-table-cell>
            <ui5-table-cell><ui5-text><%= item.wifiFailCount %></ui5-text></ui5-table-cell>
            <ui5-table-cell><ui5-text><%= item.httpFailCount %></ui5-text></ui5-table-cell>
            <ui5-table-cell><ui5-text><%= item.rssi !== null ? item.rssi + ' dBm' : '—' %></ui5-text></ui5-table-cell>

            <ui5-table-cell>
              <% if (item.reason) { %>
                <ui5-text title="<%= resetReasonCodeLabel[item.reason.resetReasonCode] || 'Tidak diketahui' %>">
                  <%= item.reason.resetReasonCode %>
                  (<%= resetReasonCodeLabel[item.reason.resetReasonCode] || 'Unknown' %>)
                </ui5-text>
              <% } else { %>
                <ui5-text class="muted">—</ui5-text>
              <% } %>
            </ui5-table-cell>

            <ui5-table-cell>
              <% if (item.reason) { %>
                <ui5-tag design="<%= item.reason.resetReason === 'PANIC' ? 'Negative' : (item.reason.resetReason === 'WATCHDOG' || item.reason.resetReason === 'BROWNOUT') ? 'Critical' : 'Neutral' %>"><%= item.reason.resetReason %></ui5-tag>
              <% } else { %>
                <ui5-text class="muted">—</ui5-text>
              <% } %>
            </ui5-table-cell>
          </ui5-table-row>
        <% }) %>
      </ui5-table>
    </div>

    <div class="table-pagination">
      <ui5-text class="muted">Page <%= logs.page %> of <%= logs.totalPages %> (<%= logs.totalItems %> incidents)</ui5-text>

      <div class="row-actions">
        <% if (logs.page > 1) { %>
          <ui5-button design="Default" icon="navigation-left-arrow" data-href="<%= buildPageUrl(logs.page - 1) %>">Prev</ui5-button>
        <% } %>

        <% if (logs.page < logs.totalPages) { %>
          <ui5-button design="Default" end-icon="navigation-right-arrow" data-href="<%= buildPageUrl(logs.page + 1) %>">Next</ui5-button>
        <% } %>
      </div>
    </div>

  <% } %>

</div>
