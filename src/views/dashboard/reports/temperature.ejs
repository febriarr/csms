<%
  function buildPageUrl(page) {
    const params = new URLSearchParams({
      deviceId: filters.deviceId || '',
      from: filters.from || '',
      to: filters.to || '',
      page: String(page),
    });
    return '/dashboard/reports/temperature?' + params.toString();
  }

  function buildExportUrl(format) {
    const params = new URLSearchParams({
      deviceId: filters.deviceId || '',
      from: filters.from || '',
      to: filters.to || '',
      format,
    });
    return '/dashboard/reports/temperature/export?' + params.toString();
  }
%>

<form method="GET" action="/dashboard/reports/temperature" id="temperature-report-form">
  <div class="field-group">
    <div class="field-filters">
      <div class="field">
        <label for="deviceId" class="field-label">Device</label>
        <select id="deviceId" name="deviceId" required class="field-input">
          <option value="" disabled <%= !filters.deviceId ? 'selected' : '' %>>Pilih device</option>
          <% devices.forEach(device => { %>
          <option value="<%= device.id %>" <%= filters.deviceId === device.id ? 'selected' : '' %>>
            <%= device.name %> (<%= device.code %>)
          </option>
          <% }) %>
        </select>
      </div>

      <div class="field">
        <label for="from" class="field-label">Dari Tanggal</label>
        <input type="date" id="from" name="from" required class="field-input" value="<%= filters.from || '' %>" />
      </div>

      <div class="field">
        <label for="to" class="field-label">Sampai Tanggal</label>
        <input type="date" id="to" name="to" required class="field-input" value="<%= filters.to || '' %>" />
      </div>

      <div class="field" style="align-self: flex-end;">
        <button type="submit" id="temperature-report-submit" class="btn btn-primary">Lihat Laporan</button>
      </div>
    </div>
  </div>
</form>

<div class="wrapper-table" data-sticky-header>
  <% if (!report) { %>
  <p class="muted-foreground p-4">Pilih device dan rentang tanggal, lalu klik "Lihat Laporan" untuk melihat histori suhu.</p>
  <% } else if (report.items.length === 0) { %>
  <p class="muted-foreground p-4">Tidak ada data suhu pada rentang tanggal yang dipilih.</p>
  <% } else { %>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem; padding: 1rem;">
    <p class="muted-foreground" style="margin: 0;">
      Menampilkan <%= (report.page - 1) * report.pageSize + 1 %>-<%= Math.min(report.page * report.pageSize, report.totalItems) %>
      dari <%= report.totalItems %> data
    </p>

    <div id="export-actions" style="display: flex; gap: 0.5rem;">
      <a href="<%= buildExportUrl('xlsx') %>" id="export-xlsx-btn" class="btn btn-success" style="text-decoration: none;">Export Excel</a>
      <a href="<%= buildExportUrl('csv') %>" id="export-csv-btn" class="btn btn-outline" style="text-decoration: none;">Export CSV</a>
    </div>
  </div>

  <p id="export-range-warning" class="muted-foreground" style="display: none; color: #dc2626; margin-top: -0.5rem; margin-bottom: 0.75rem;">
    Rentang tanggal lebih dari 1 bulan — export tidak tersedia. Persempit rentang tanggal terlebih dahulu.
  </p>

  <table class="dashboard-table" data-sticky-header>
    <thead class="muted muted-foreground">
      <tr>
        <th style="width: 60px;">No</th>
        <th>Waktu Rekam</th>
        <th>Suhu</th>
      </tr>
    </thead>
    <tbody>
      <% report.items.forEach((log, i) => { %>
      <tr>
        <td><%= (report.page - 1) * report.pageSize + i + 1 %></td>
        <td><%= formatDateTime(log.recordedAt) %></td>
        <td><%= log.temperature %>°C</td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <% if (report.totalPages > 1) { %>
  <div style="display: flex; gap: 0.5rem; justify-content: center; margin-top: 1rem; padding: 1rem;">
    <% if (report.page > 1) { %>
    <a href="<%= buildPageUrl(report.page - 1) %>" class="btn btn-outline foreground" style="text-decoration: none;">Sebelumnya</a>
    <% } %>
    <span class="muted-foreground" style="align-self: center;">Halaman <%= report.page %> dari <%= report.totalPages %></span>
    <% if (report.page < report.totalPages) { %>
    <a href="<%= buildPageUrl(report.page + 1) %>" class="btn btn-outline foreground" style="text-decoration: none;">Berikutnya</a>
    <% } %>
  </div>
  <% } %>
  <% } %>
</div>