<%
function buildPageUrl(page){const params=new URLSearchParams({deviceId:filters.deviceId||'',from:filters.from||'',to:filters.to||'',page:String(page)});return '/dashboard/reports/temperature?'+params.toString();}
function buildExportUrl(format){const params=new URLSearchParams({deviceId:filters.deviceId||'',from:filters.from||'',to:filters.to||'',format});return '/dashboard/reports/temperature/export?'+params.toString();}
%>
<div class="dashboard-page-header">
  <div>
    <p class="dashboard-page-eyebrow">Analytics</p>
    <h2>Temperature Report</h2>
    <p>Review raw temperature telemetry and export the selected range.</p>
  </div>
</div>
<form method="GET" action="/dashboard/reports/temperature" id="temperature-report-form" class="filter-bar">
  <div class="field-filters">
    <div class="field">
      <ui5-label for="deviceId" required>Device</ui5-label>
      <ui5-select id="deviceId" name="deviceId" required>
        <ui5-option value="" <%= !filters.deviceId ? 'selected' : '' %>>Choose device</ui5-option><% devices.forEach(device=>{ %><ui5-option value="<%= device.id %>" <%= filters.deviceId===device.id?'selected':'' %>><%= device.name %> (<%= device.code %>)</ui5-option><% }) %>
      </ui5-select>
    </div>
    <div class="field">
      <ui5-label for="from" required>From Date</ui5-label>
      <ui5-date-picker id="from" name="from" value="<%= filters.from || '' %>" required></ui5-date-picker>
    </div>
    <div class="field">
      <ui5-label for="to" required>To Date</ui5-label>
      <ui5-date-picker id="to" name="to" value="<%= filters.to || '' %>" required></ui5-date-picker>
    </div>
    <ui5-button type="Submit" id="temperature-report-submit" design="Emphasized">Show Report</ui5-button>
  </div>
</form>
<div class="ui5-table-shell"><% if(!report){ %><div class="section-body">
    <ui5-message-strip design="Information" hide-close-button>Pilih device dan rentang tanggal, lalu klik "Show Report" untuk melihat histori suhu.</ui5-message-strip>
  </div><% } else if(report.items.length===0){ %><div class="section-body">
    <ui5-message-strip design="Warning" hide-close-button>Tidak ada data suhu pada rentang tanggal yang dipilih.</ui5-message-strip>
  </div><% } else { %>
  <div class="section-toolbar">
    <div><strong>Temperature History</strong><span class="muted-foreground"> &nbsp; Show <%= (report.page-1)*report.pageSize+1 %>–<%= Math.min(report.page*report.pageSize,report.totalItems) %> of <%= report.totalItems %> items</span></div>
    <div id="export-actions" class="page-actions"><a href="<%= buildExportUrl('xlsx') %>" id="export-xlsx-btn" class="btn btn-success">
        <ui5-icon name="excel-attachment" style="color: white;"></ui5-icon>Export Excel
      </a><a href="<%= buildExportUrl('csv') %>" id="export-csv-btn" class="btn btn-outline">Export CSV</a></div>
  </div>
  <p id="export-range-warning" class="section-body export-range-warning">Rentang tanggal lebih dari 1 bulan — export tidak tersedia. Persempit rentang tanggal terlebih dahulu.</p>
  <ui5-table class="enterprise-table" overflow-mode="Scroll" accessible-name="Temperature History" style="height: 600px;">
    <ui5-table-header-row slot="headerRow" sticky>
      <ui5-table-header-cell min-width="max-content">No</ui5-table-header-cell>
      <ui5-table-header-cell min-width="max-content">Recorded At</ui5-table-header-cell>
      <ui5-table-header-cell min-width="max-content">Temperature</ui5-table-header-cell>
    </ui5-table-header-row><% report.items.forEach((log,i)=>{ %><ui5-table-row>
      <ui5-table-cell><%= (report.page-1)*report.pageSize+i+1 %></ui5-table-cell>
      <ui5-table-cell><%= formatDateTime(log.recordedAt) %></ui5-table-cell>
      <ui5-table-cell><strong><%= log.temperature %> °C</strong></ui5-table-cell>
    </ui5-table-row><% }) %>
  </ui5-table>
  <% if(report.totalPages>1){ %><div class="table-pagination"><% if(report.page>1){ %><a href="<%= buildPageUrl(report.page-1) %>" class="btn btn-outline">Previous</a><% } %><span class="muted-foreground">Page <%= report.page %> of <%= report.totalPages %></span><% if(report.page<report.totalPages){ %><a href="<%= buildPageUrl(report.page+1) %>" class="btn btn-outline">Next</a><% } %></div><% } %><% } %>
</div>