<%
function buildDeviceUrl(deviceId) {
  const params = new URLSearchParams({ from: filters.from || '', to: filters.to || '', deviceId: deviceId });
  return '/dashboard/reports/diagnostics?' + params.toString();
}

function buildDeviceDetailUrl(deviceId) {
  const params = new URLSearchParams({ from: filters.from || '', to: filters.to || '', deviceId: deviceId });
  return '/dashboard/reports/diagnostics/detail?' + params.toString();
}

const reasonTagDesign = { BROWNOUT: 'Negative', PANIC: 'Critical', WATCHDOG: 'Critical', UNKNOWN: 'Neutral' };
%>
<div class="stack">

  <form method="GET" action="/dashboard/reports/diagnostics" id="diagnostics-report-form" class="toolbar-row toolbar-row--filters">
    <div class="field">
      <ui5-label for="from" required>From Date</ui5-label>
      <ui5-date-picker id="from" name="from" value-format="yyyy-MM-dd" display-format="yyyy-MM-dd" value="<%= filters.from %>" required></ui5-date-picker>
    </div>

    <div class="field">
      <ui5-label for="to" required>To Date</ui5-label>
      <ui5-date-picker id="to" name="to" value-format="yyyy-MM-dd" display-format="yyyy-MM-dd" value="<%= filters.to %>" required></ui5-date-picker>
    </div>

    <% if (filters.deviceId) { %>
      <input type="hidden" name="deviceId" value="<%= filters.deviceId %>" />
    <% } %>

    <ui5-button type="Submit" design="Emphasized" icon="filter">Apply</ui5-button>
  </form>

  <ui5-panel header-text="Ranking Device" fixed>
    <% if (summary.length === 0) { %>

      <ui5-message-strip design="Information" hide-close-button>
        Tidak ada kejadian sensor/WiFi/HTTP gagal pada rentang tanggal ini.
      </ui5-message-strip>

    <% } else { %>

      <ui5-table id="table" sticky-column-header overflow-mode="Scroll" accessible-name="Device Diagnostics Ranking">
        <ui5-table-header-row slot="headerRow">
          <ui5-table-header-cell min-width="max-content">Device</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Sensor Fail</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">WiFi Fail</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">HTTP Fail</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Avg RSSI</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Last Reason</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Total</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Actions</ui5-table-header-cell>
        </ui5-table-header-row>

        <% summary.forEach(row => { %>
          <ui5-table-row>
            <ui5-table-cell>
              <div class="cell-stack">
                <ui5-text class="cell-strong"><%= row.deviceName %></ui5-text>
                <ui5-text class="muted"><%= row.deviceCode %></ui5-text>
              </div>
            </ui5-table-cell>

            <ui5-table-cell><ui5-text><%= row.sensorFailTotal %></ui5-text></ui5-table-cell>
            <ui5-table-cell><ui5-text><%= row.wifiFailTotal %></ui5-text></ui5-table-cell>
            <ui5-table-cell><ui5-text><%= row.httpFailTotal %></ui5-text></ui5-table-cell>
            <ui5-table-cell><ui5-text><%= row.avgRssi !== null ? row.avgRssi + ' dBm' : '—' %></ui5-text></ui5-table-cell>

            <ui5-table-cell>
              <% if (row.lastReason) { %>
                <ui5-tag
                  design="<%= reasonTagDesign[row.lastReason.resetReason] || 'Neutral' %>"
                  title="RSSI saat itu: <%= row.lastReason.lastRssi !== null ? row.lastReason.lastRssi + ' dBm' : 'tidak diketahui' %> · WiFi Fail: <%= row.lastReason.lastWifiFailCount %> · Sensor Fail: <%= row.lastReason.lastSensorFailCount %> · HTTP Fail: <%= row.lastReason.lastHttpFailCount %>"
                ><%= row.lastReason.resetReason %></ui5-tag>
              <% } else { %>
                <ui5-text class="muted">—</ui5-text>
              <% } %>
            </ui5-table-cell>

            <ui5-table-cell><ui5-text class="cell-strong"><%= row.total %></ui5-text></ui5-table-cell>

            <ui5-table-cell>
              <div class="row-actions">
                <ui5-link href="<%= buildDeviceUrl(row.deviceId) %>">Show Trend</ui5-link>
                <ui5-link href="<%= buildDeviceDetailUrl(row.deviceId) %>">Show Detail</ui5-link>
              </div>
            </ui5-table-cell>
          </ui5-table-row>
        <% }) %>
      </ui5-table>

    <% } %>
  </ui5-panel>

  <% if (selectedDevice && trend) { %>
    <ui5-panel header-text="Tren Harian — <%= selectedDevice.deviceName %> (<%= selectedDevice.deviceCode %>)" fixed>
      <% if (trend.length === 0) { %>

        <ui5-message-strip design="Information" hide-close-button>
          Tidak ada data tren untuk device ini pada rentang tanggal ini.
        </ui5-message-strip>

      <% } else { %>

        <div
          id="diagnostics-trend-chart"
          data-chart='<%- JSON.stringify({
            days: trend.map(t => t.day),
            sensor: trend.map(t => t.sensorFailTotal),
            wifi: trend.map(t => t.wifiFailTotal),
            http: trend.map(t => t.httpFailTotal),
            rssi: trend.map(t => t.avgRssi),
          }) %>'
        ></div>

      <% } %>
    </ui5-panel>
  <% } %>

</div>
