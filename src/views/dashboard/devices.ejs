<%
  const stateDesign = { NORMAL: 'Positive', WARNING: 'Critical', CRITICAL: 'Negative', DEFROST: 'Information' };
%>
<div class="stack">

  <div class="toolbar-row">
    <div class="search-field">
      <ui5-input
        id="search-input-device"
        placeholder="Search by device code or name"
        value="<%= currentSearch || '' %>"
        show-clear-icon
      ></ui5-input>
      <ui5-button id="search-button-device" design="Emphasized" icon="search">Search</ui5-button>
    </div>

    <span class="toolbar-spacer"></span>

    <ui5-button design="Emphasized" icon="add" data-href="/dashboard/devices/create">Create Device</ui5-button>
  </div>

  <% if (currentSearch) { %>
    <div class="toolbar-row">
      <ui5-tag design="Information">Search: <%= currentSearch %></ui5-tag>
      <ui5-button id="clear-search" design="Transparent" icon="decline">Clear Filters</ui5-button>
    </div>
  <% } %>

  <% if (devices && devices.length) { %>

    <div class="surface">
      <ui5-table sticky-column-header overflow-mode="Scroll" accessible-name="Devices">
        <ui5-table-header-row slot="headerRow">
          <ui5-table-header-cell min-width="max-content">Device</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Location</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Normal</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Defrost</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Warning</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Critical</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Status</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Actions</ui5-table-header-cell>
        </ui5-table-header-row>

        <% devices.forEach(device => { %>
          <ui5-table-row>
            <ui5-table-cell>
              <div class="cell-stack">
                <ui5-text class="cell-strong"><%= device.name %></ui5-text>
                <ui5-text class="muted"><%= device.code %></ui5-text>
              </div>
            </ui5-table-cell>

            <ui5-table-cell><ui5-text><%= device.location || '-' %></ui5-text></ui5-table-cell>
            <ui5-table-cell><ui5-text>&lt; <%= device.defrostThreshold %>°C</ui5-text></ui5-table-cell>
            <ui5-table-cell><ui5-text><%= device.defrostThreshold %> – <%= device.warningThreshold %>°C</ui5-text></ui5-table-cell>
            <ui5-table-cell><ui5-text><%= device.warningThreshold %> – <%= device.criticalThreshold %>°C</ui5-text></ui5-table-cell>
            <ui5-table-cell><ui5-text>≥ <%= device.criticalThreshold %>°C</ui5-text></ui5-table-cell>

            <ui5-table-cell>
              <ui5-tag design="<%= stateDesign[device.state] ?? 'Neutral' %>"><%= device.state %></ui5-tag>
            </ui5-table-cell>

            <ui5-table-cell>
              <div class="row-actions">
                <ui5-button
                  design="Transparent"
                  icon="edit"
                  tooltip="Edit device"
                  accessible-name="Edit <%= device.name %>"
                  data-href="/dashboard/devices/<%= device.id %>/update"
                ></ui5-button>

                <ui5-button
                  design="Transparent"
                  icon="delete"
                  tooltip="Delete device"
                  accessible-name="Delete <%= device.name %>"
                  data-action="delete"
                  data-id="<%= device.id %>"
                  data-name="<%= device.name %>"
                ></ui5-button>
              </div>
            </ui5-table-cell>
          </ui5-table-row>
        <% }) %>
      </ui5-table>
    </div>

  <% } else { %>

    <ui5-message-strip design="Information" hide-close-button>Belum ada data device.</ui5-message-strip>

  <% } %>

</div>
