<div class="dashboard-page-header">

  <div>

    <p class="dashboard-page-eyebrow">
      Master Data
    </p>

    <h2>
      <%= pageTitle %>
    </h2>

    <p>
      Kelola perangkat monitoring dan batas temperatur operasional.
    </p>

  </div>


  <a
    href="/dashboard/devices/create"
    class="btn btn-primary"
  >
    <ui5-icon name="add" style="color: inherit;"></ui5-icon>
    Create Device
  </a>

</div>


<div class="filter-bar">

  <div class="section-toolbar section-toolbar--compact">

    <div class="section-toolbar__left search-field">

      <ui5-input
        id="search-input-device"
        placeholder="Search by device code or name"
        value="<%= currentSearch || '' %>"
        style="width: 100%;"
      ></ui5-input>

      <ui5-button
        id="search-button-device"
        design="Emphasized"
      >
        Search
      </ui5-button>

    </div>

  </div>

</div>


<% if (currentSearch) { %>

  <div class="filter-chips">

    <span class="chip">

      Search:
      <strong>
        <%= currentSearch %>
      </strong>

      <button
        type="button"
        class="chip-remove"
        id="clear-search"
        aria-label="Clear filter"
      >
        ×
      </button>

    </span>

  </div>

<% } %>


<ui5-table
  class="enterprise-table"
  sticky-column-header
  overflow-mode="Scroll"
  accessible-name="Devices"
>

  <ui5-table-header-row slot="headerRow">

    <ui5-table-header-cell min-width="240px">
      Device
    </ui5-table-header-cell>

    <ui5-table-header-cell min-width="200px">
      Location
    </ui5-table-header-cell>

    <ui5-table-header-cell min-width="140px">
      Normal
    </ui5-table-header-cell>

    <ui5-table-header-cell min-width="140px">
      Defrost
    </ui5-table-header-cell>

    <ui5-table-header-cell min-width="140px">
      Warning
    </ui5-table-header-cell>

    <ui5-table-header-cell min-width="140px">
      Critical
    </ui5-table-header-cell>

    <ui5-table-header-cell min-width="140px">
      Status
    </ui5-table-header-cell>

    <ui5-table-header-cell min-width="160px">
      Actions
    </ui5-table-header-cell>

  </ui5-table-header-row>


  <% if (devices && devices.length) { %>

    <% devices.forEach(device => { %>

      <ui5-table-row>

        <!-- Device -->
        <ui5-table-cell min-width="240px" style="display: flex;gap: 0.5rem; align-items: center;">

          <div class="device-name">
            <%= device.name %>
          </div>

          <div class="device-code">
            <%= device.code %>
          </div>

        </ui5-table-cell>


        <!-- Location -->
        <ui5-table-cell min-width="200px">
          <%= device.location || '-' %>
        </ui5-table-cell>


        <!-- Normal -->
        <ui5-table-cell min-width="140px">
          &lt; <%= device.defrostThreshold %>°C
        </ui5-table-cell>


        <!-- Defrost -->
        <ui5-table-cell min-width="140px">
          <%= device.defrostThreshold %>
          –
          <%= device.warningThreshold %>°C
        </ui5-table-cell>


        <!-- Warning -->
        <ui5-table-cell min-width="140px">
          <%= device.warningThreshold %>
          –
          <%= device.criticalThreshold %>°C
        </ui5-table-cell>


        <!-- Critical -->
        <ui5-table-cell min-width="140px">
          ≥ <%= device.criticalThreshold %>°C
        </ui5-table-cell>


        <!-- Status -->
        <ui5-table-cell min-width="140px">

          <ui5-tag
            design="<%= device.state === 'NORMAL'
              ? 'Positive'
              : device.state === 'WARNING'
                ? 'Critical'
                : device.state === 'CRITICAL'
                  ? 'Negative'
                  : device.state === 'DEFROST'
                    ? 'Information'
                    : 'Neutral' %>"
          >
            <%= device.state %>
          </ui5-tag>

        </ui5-table-cell>


        <!-- Actions -->
        <ui5-table-cell min-width="160px">

          <div class="page-actions">

            <a
              href="/dashboard/devices/<%= device.id %>/update"
              class="btn btn-icon-sm btn-outline"
              title="Edit"
            >
              <ui5-icon name="edit"></ui5-icon>
            </a>


            <button
              type="button"
              class="btn btn-icon-sm btn-danger btn-delete-device"
              data-id="<%= device.id %>"
              data-name="<%= device.name %>"
              title="Delete"
            >
              <ui5-icon name="delete"></ui5-icon>
            </button>

          </div>

        </ui5-table-cell>

      </ui5-table-row>

    <% }) %>


  <% } else { %>

    <ui5-table-row>

      <ui5-table-cell
        colspan="8"
        class="empty-state"
      >
        Belum ada data device.
      </ui5-table-cell>

    </ui5-table-row>

  <% } %>

</ui5-table>