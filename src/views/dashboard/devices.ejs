<div class="flex-between">

  <div style="width: 100%; max-width: 500px; display: flex; gap: 0.5rem;  align-items: center;">
    <input type="text" placeholder="cari berdasarkan code atau nama" id="search-input-device" class="field-input" style="max-width: 500px;">
    <button class="btn btn-outline" id="search-button-device">Search</button>
  </div>

  <a href="/dashboard/devices/create" style="text-decoration: none; color: white;">
    <button class="btn btn-primary">Create Device</button>
  </a>
</div>
<% if (currentSearch) { %>
  <div class="filter-chips">
    <span class="chip">
      <span>"<%= currentSearch %>"</span>
      <button
        type="button"
        class="chip-remove"
        id="clear-search"
        aria-label="Hapus filter"
      >
        <i class="ph ph-x" style="color: var(--state-normal); font-weight: bold;"></i>
      </button>
    </span>
  </div>
<% } %>
<div class="wrapper-table">
  <table class="dashboard-table">
    <thead class="muted muted-foreground">
      <tr>
        <th style="width: 350px;">Device</th>
        <th style="width: 350px;">Location</th>
        <th>Threshold Normal</th>
        <th>Threshold Defrost</th>
        <th>Threshold Warning</th>
        <th>Threshold Critical</th>
        <th>Status</th>
        <th>Aksi</th>
      </tr>
    </thead>
    <tbody>
      <% if (devices && devices.length > 0) { %>
        <% devices.forEach(device => { %>
          <tr style="width: 350px;">
            <td>
              <div class="device-name"><%= device.name %></div>
              <div class="device-code"><%= device.code %></div>
            </td>
            <td style="width: 350px;"><%= device.location || '-' %></td>
            <td>
            
              <%= device.normalMinTemperature %>°C &ndash; <%= device.normalMaxTemperature %>°C
         
            </td>

            <td>
              <%= device.defrostMinTemperature %>°C &ndash; <%= device.defrostMaxTemperature %>°C
            </td>

            <td>
              <%= device.warningMinTemperature %>°C &ndash; <%= device.warningMaxTemperature %>°C
            </td>

            <td>
              >= <%= device.criticalMinTemperature %>°C
            </td>
           
            <td>
              <span style="padding: 4px 1rem !important; font-size: small !important; border-radius: 4px;" class="status-<%= device.state.toLowerCase() %>">
                <%= device.state %>
              </span>
            </td>
            <td>
              <button
                type="button"
                class="btn-icon-sm btn-danger btn-sm btn-delete-device"
                data-id="<%= device.id %>"
                data-name="<%= device.name %>"
              >
                <i class="ph ph-trash"></i>
              </button>
          </td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="7" class="empty-state">Belum ada data device.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>