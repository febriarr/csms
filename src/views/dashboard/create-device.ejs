<form id="form-create-device" class="form-card">
  <div class="form-card__header">
    <ui5-title level="H4">Device Information</ui5-title>
    <ui5-text class="muted">Identitas device dan operational temperature thresholds.</ui5-text>
  </div>

  <div class="form-card__body form-grid">
    <div class="field">
      <ui5-label for="name" required>Nama</ui5-label>
      <ui5-input id="name" name="name" placeholder="Nama Devices" required></ui5-input>
    </div>

    <div class="field">
      <ui5-label for="code" required>Alias</ui5-label>
      <ui5-input id="code" name="code" placeholder="Kode unik device" required></ui5-input>
    </div>

    <div class="field full">
      <ui5-label for="location">Lokasi</ui5-label>
      <ui5-input id="location" name="location" placeholder="Lokasi device"></ui5-input>
    </div>

    <div class="field">
      <ui5-label for="defrostThreshold" required>Batas Suhu Defrost</ui5-label>
      <ui5-input id="defrostThreshold" name="defrostThreshold" type="Number" placeholder="cth -18" required></ui5-input>
    </div>

    <div class="field">
      <ui5-label for="warningThreshold" required>Batas Suhu Warning</ui5-label>
      <ui5-input id="warningThreshold" name="warningThreshold" type="Number" placeholder="cth -5" required></ui5-input>
    </div>

    <div class="field">
      <ui5-label for="criticalThreshold" required>Batas Suhu Critical</ui5-label>
      <ui5-input id="criticalThreshold" name="criticalThreshold" type="Number" placeholder="cth 0" required></ui5-input>
    </div>
  </div>

  <div class="form-card__actions">
    <ui5-button design="Transparent" data-href="/dashboard/devices">Cancel</ui5-button>
    <ui5-button type="Submit" design="Emphasized">Create Device</ui5-button>
  </div>
</form>
