<div class="dashboard-page-header"><div><p class="dashboard-page-eyebrow">Devices</p><h2>Create Device</h2><p>Register a new cold storage monitoring device.</p></div></div>
<form id="form-create-device" class="enterprise-form form-card"><div class="form-card__header"><h3 class="section-title">Device Information</h3><p class="section-subtitle">Identitas device dan operational temperature thresholds.</p></div><div class="form-card__body"><div class="form-grid"><div class="field"><ui5-label for="name" required>Nama</ui5-label><ui5-input id="name" name="name" placeholder="Nama Devices" required></ui5-input></div><div class="field"><ui5-label for="code" required>Alias</ui5-label><ui5-input id="code" name="code" placeholder="Kode unik device" required></ui5-input></div><div class="field full"><ui5-label for="location">Lokasi</ui5-label><ui5-input id="location" name="location" placeholder="Lokasi device"></ui5-input></div><div class="field"><ui5-label for="defrostThreshold" required>Batas Suhu Defrost</ui5-label><ui5-input id="defrostThreshold" name="defrostThreshold" type="Number" placeholder="cth -18" required></ui5-input></div><div class="field"><ui5-label for="warningThreshold" required>Batas Suhu Warning</ui5-label><ui5-input id="warningThreshold" name="warningThreshold" type="Number" placeholder="cth -5" required></ui5-input></div><div class="field"><ui5-label for="criticalThreshold" required>Batas Suhu Critical</ui5-label><ui5-input id="criticalThreshold" name="criticalThreshold" type="Number" placeholder="cth 0" required></ui5-input></div></div></div><div class="form-card__actions"><a href="/dashboard/devices" class="btn btn-outline">Cancel</a><ui5-button type="Submit" design="Emphasized">Create Device</ui5-button></div></form>
