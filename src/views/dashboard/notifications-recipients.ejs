<div class="stack">

  <div class="toolbar-row toolbar-row--filters">
    <div class="field-inline">
      <ui5-label for="search-name">Name</ui5-label>
      <ui5-input id="search-name" placeholder="Search name..." value="<%= currentName || '' %>" show-clear-icon></ui5-input>
    </div>

    <div class="field-inline">
      <ui5-label for="search-channel">Channel</ui5-label>
      <ui5-select id="search-channel" accessible-name="Channel filter">
        <ui5-option value="" <%= !currentChannel ? 'selected' : '' %>>All Channels</ui5-option>
        <ui5-option value="email" <%= currentChannel === 'email' ? 'selected' : '' %>>Email</ui5-option>
        <ui5-option value="whatsapp" <%= currentChannel === 'whatsapp' ? 'selected' : '' %>>WhatsApp</ui5-option>
      </ui5-select>
    </div>

    <ui5-button id="search-button-notification-recipient" design="Emphasized" icon="search">Search</ui5-button>

    <span class="toolbar-spacer"></span>

    <ui5-button
      id="create-notification-recipient"
      design="Emphasized"
      icon="add"
      accessible-name="Create notification recipient"
      data-href="/dashboard/notifications-recipients/create"
    >Create Recipient</ui5-button>
  </div>

  <% if (currentName || currentChannel) { %>
    <div class="toolbar-row">
      <% if (currentName) { %>
        <ui5-tag design="Information">Name: <%= currentName %></ui5-tag>
      <% } %>

      <% if (currentChannel) { %>
        <ui5-tag design="Information">Channel: <%= currentChannel === 'email' ? 'Email' : 'WhatsApp' %></ui5-tag>
      <% } %>

      <ui5-button id="clear-search" design="Transparent" icon="decline">Clear Filters</ui5-button>
    </div>
  <% } %>

  <% if (data && data.length) { %>

    <div class="surface">
      <ui5-table id="table" overflow-mode="Scroll" sticky-column-header accessible-name="Notification Recipients">
        <ui5-table-header-row slot="headerRow">
          <ui5-table-header-cell min-width="max-content">Recipient</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Channel</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Target</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Status</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Actions</ui5-table-header-cell>
        </ui5-table-header-row>

        <% data.forEach(recipient => { %>
          <ui5-table-row>
            <ui5-table-cell><ui5-text class="cell-strong"><%= recipient.name %></ui5-text></ui5-table-cell>

            <ui5-table-cell>
              <ui5-tag design="Information"><%= recipient.channel === 'email' ? 'Email' : 'WhatsApp' %></ui5-tag>
            </ui5-table-cell>

            <ui5-table-cell><ui5-text><%= recipient.target %></ui5-text></ui5-table-cell>

            <ui5-table-cell>
              <ui5-tag design="<%= recipient.isActive ? 'Positive' : 'Negative' %>"><%= recipient.isActive ? 'Active' : 'Inactive' %></ui5-tag>
            </ui5-table-cell>

            <ui5-table-cell>
              <div class="row-actions">
                <ui5-button
                  design="Transparent"
                  icon="edit"
                  tooltip="Edit recipient"
                  accessible-name="Edit <%= recipient.name %>"
                  data-href="/dashboard/notifications-recipients/<%= recipient.id %>/edit"
                ></ui5-button>

                <ui5-button
                  design="Transparent"
                  icon="delete"
                  tooltip="Delete recipient"
                  accessible-name="Delete <%= recipient.name %>"
                  data-action="delete"
                  data-id="<%= recipient.id %>"
                  data-name="<%= recipient.name %>"
                ></ui5-button>
              </div>
            </ui5-table-cell>
          </ui5-table-row>
        <% }) %>
      </ui5-table>
    </div>

  <% } else { %>

    <ui5-message-strip design="Information" hide-close-button>No notification recipients found.</ui5-message-strip>

  <% } %>

</div>
