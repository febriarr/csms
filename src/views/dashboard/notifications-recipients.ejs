<div class="dashboard-page-header">
  <div>
    <p class="dashboard-page-eyebrow">Notifications</p>

    <h2><%= pageTitle %></h2>

    <p>Kelola penerima alert temperatur abnormal.</p>
  </div>

  <a
    href="/dashboard/notifications-recipients/create"
    class="btn btn-primary"
  >
    <ui5-icon name="add" style="color: inherit;"></ui5-icon>
    Create Recipient
  </a>
</div>


<div class="filter-bar">
  <div class="field-filters notification-filters">

    <div class="field">
      <ui5-label for="search-name">
        Name
      </ui5-label>

      <ui5-input
        id="search-name"
        placeholder="Search name..."
        value="<%= currentName || '' %>"
      ></ui5-input>
    </div>


    <div class="field">
      <ui5-label for="search-channel">
        Channel
      </ui5-label>

      <ui5-select id="search-channel">

        <ui5-option value="">
          All Channels
        </ui5-option>

        <ui5-option
          value="email"
          <%= currentChannel === 'email' ? 'selected' : '' %>
        >
          Email
        </ui5-option>

        <ui5-option
          value="whatsapp"
          <%= currentChannel === 'whatsapp' ? 'selected' : '' %>
        >
          WhatsApp
        </ui5-option>

      </ui5-select>
    </div>


    <ui5-button
      id="search-button-notification-recipient"
      design="Emphasized"
    >
      Search
    </ui5-button>

  </div>
</div>


<% if (currentName || currentChannel) { %>

  <div class="filter-chips">

    <% if (currentName) { %>

      <span class="chip">
        Name:
        <strong><%= currentName %></strong>
      </span>

    <% } %>


    <% if (currentChannel) { %>

      <span class="chip">
        Channel:
        <strong><%= currentChannel %></strong>
      </span>

    <% } %>


    <button
      type="button"
      class="chip-remove"
      id="clear-search"
    >
      Clear filters
    </button>

  </div>

<% } %>


<div class="ui5-table-shell">

  <ui5-table
    class="enterprise-table"
    id="table"
    style="height: 600px; width: 100%;"
    overflow-mode="Scroll"
    accessible-name="Notification Recipients"
  >

    <ui5-table-header-row slot="headerRow">

      <ui5-table-header-cell min-width="max-content">
        Recipient
      </ui5-table-header-cell>


      <ui5-table-header-cell min-width="max-content">
        Channel
      </ui5-table-header-cell>


      <ui5-table-header-cell min-width="max-content">
        Target
      </ui5-table-header-cell>


      <ui5-table-header-cell min-width="max-content">
        Status
      </ui5-table-header-cell>


      <ui5-table-header-cell min-width="max-content">
        Actions
      </ui5-table-header-cell>

    </ui5-table-header-row>


    <% if (data && data.length) { %>

      <% data.forEach(recipient => { %>

        <ui5-table-row>

          <!-- Recipient -->
          <ui5-table-cell>

            <div class="device-name">
              <%= recipient.name %>
            </div>

          </ui5-table-cell>


          <!-- Channel -->
          <ui5-table-cell>

            <ui5-tag design="Information">
              <%= recipient.channel === 'email' ? 'Email' : 'WhatsApp' %>
            </ui5-tag>

          </ui5-table-cell>


          <!-- Target -->
          <ui5-table-cell>

            <%= recipient.target %>

          </ui5-table-cell>


          <!-- Status -->
          <ui5-table-cell>

            <ui5-tag
              design="<%= recipient.isActive ? 'Positive' : 'Negative' %>"
            >
              <%= recipient.isActive ? 'Active' : 'Inactive' %>
            </ui5-tag>

          </ui5-table-cell>


          <!-- Actions -->
          <ui5-table-cell>

            <div class="page-actions notification-row-actions">

              <a
                href="/dashboard/notifications-recipients/<%= recipient.id %>/edit"
                class="btn btn-icon-sm btn-outline"
              >
                <ui5-icon name="edit"></ui5-icon>
              </a>


              <button
                type="button"
                class="btn btn-icon-sm btn-danger btn-delete-notification-recipient"
                data-id="<%= recipient.id %>"
                data-name="<%= recipient.name %>"
              >
                <ui5-icon name="delete"></ui5-icon>
              </button>

            </div>

          </ui5-table-cell>

        </ui5-table-row>

      <% }) %>


    <% } else { %>

      <ui5-table-row>

        <ui5-table-cell
          colspan="5"
          class="empty-state"
        >
          No notification recipients found.
        </ui5-table-cell>

      </ui5-table-row>

    <% } %>

  </ui5-table>

</div>