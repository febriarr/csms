<div class="flex-between">

  <div
    style="
      width: 100%;
      display: flex;
      gap: .5rem;
      align-items: center;
      flex-wrap: wrap;
    "
  >
    <input
      type="text"
      id="search-name"
      class="field-input"
      placeholder="Search name..."
      value="<%= currentName || '' %>"
      style="max-width: 220px;"
    />

    <select
      id="search-channel"
      class="field-input"
      style="max-width: 180px;"
    >
      <option value="">All Channels</option>

      <option
        value="email"
        <%= currentChannel === 'email' ? 'selected' : '' %>>
        Email
      </option>

      <option
        value="whatsapp"
        <%= currentChannel === 'whatsapp' ? 'selected' : '' %>>
        WhatsApp
      </option>
    </select>

    <button
      class="btn btn-outline"
      id="search-button-notification-recipient"
    >
      Search
    </button>
  </div>

  <a
    href="/dashboard/notifications-recipients/create"
    style="text-decoration:none;color:white;"
  >
    <button class="btn btn-primary">
      Create Recipient
    </button>
  </a>

</div>

<% if (currentName || currentChannel) { %>

<div class="filter-chips">

  <% if (currentName) { %>
  <span class="chip">
    Name:
    <span><%= currentName %></span>
  </span>
  <% } %>

  <% if (currentChannel) { %>
  <span class="chip">
    Channel:
    <span><%= currentChannel %></span>
  </span>
  <% } %>

  <button
    type="button"
    class="chip-remove"
    id="clear-search"
    aria-label="Clear filters"
  >
    <i
      class="ph ph-x"
      style="color: var(--state-normal); font-weight:bold;"
    ></i>
  </button>

</div>

<% } %>

<div class="wrapper-table">

  <table class="dashboard-table">

    <thead class="muted muted-foreground">
      <tr>
        <th style="width:240px;">Recipient</th>
        <th style="width:150px;">Channel</th>
        <th>Target</th>
        <th style="width:140px;">Status</th>
        <th style="width:180px;">Created At</th>
        <th style="width:100px;">Action</th>
      </tr>
    </thead>

    <tbody>

      <% if (data && data.length > 0) { %>

      <% data.forEach(recipient => { %>

      <tr>

        <td>
          <div class="device-name">
            <%= recipient.name %>
          </div>
        </td>

        <td>

          <% if (recipient.channel === 'email') { %>

          <span
            style="
              display:flex;
              align-items:center;
              gap:.35rem;
            "
          >
            <i class="ph ph-envelope-simple"></i>
            Email
          </span>

          <% } else { %>

          <span
            style="
              display:flex;
              align-items:center;
              gap:.35rem;
            "
          >
            <i class="ph ph-whatsapp-logo"></i>
            WhatsApp
          </span>

          <% } %>

        </td>

        <td>
          <%= recipient.target %>
        </td>

        <td>

          <% if (recipient.isActive) { %>

          <span
            class="status-normal"
            style="
              padding:4px 1rem;
              border-radius:4px;
              font-size:small;
            "
          >
            Active
          </span>

          <% } else { %>

          <span
            class="status-critical"
            style="
              padding:4px 1rem;
              border-radius:4px;
              font-size:small;
            "
          >
            Inactive
          </span>

          <% } %>

        </td>

        <td>
          <%= formatDateTime(recipient.createdAt) %>
        </td>

        <td>

          <div
            style="
              display:flex;
              gap:.5rem;
            "
          >

            <a
              href="/dashboard/notifications-recipients/<%= recipient.id %>/edit"
            >
              <button
                type="button"
                class="btn-icon-sm btn-primary btn-sm"
              >
                <i class="ph ph-pencil-simple"></i>
              </button>
            </a>

            <button
              type="button"
              class="btn-icon-sm btn-danger btn-sm btn-delete-notification-recipient"
              data-id="<%= recipient.id %>"
              data-name="<%= recipient.name %>"
            >
              <i class="ph ph-trash"></i>
            </button>

          </div>

        </td>

      </tr>

      <% }) %>

      <% } else { %>

      <tr>
        <td
          colspan="6"
          class="empty-state"
        >
          No notification recipients found.
        </td>
      </tr>

      <% } %>

    </tbody>

  </table>

</div>