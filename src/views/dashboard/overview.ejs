<ui5-panel header-text="Today Diagnostics" accessible-name="Today diagnostics" fixed>
  <div class="stack">
    <div class="toolbar-row">
      <ui5-text class="muted">Device dengan kejadian sensor, Wi-Fi, atau HTTP.</ui5-text>
      <span class="toolbar-spacer"></span>
      <ui5-button
        id="diagnostics-view-details"
        design="Transparent"
        icon="display"
        accessible-name="View diagnostics details"
        data-href="/dashboard/reports/diagnostics"
      >View Details</ui5-button>
    </div>

    <% if (diagnosticsToday.length === 0) { %>

      <ui5-message-strip design="Positive" hide-close-button>
        Belum ada kejadian sensor/WiFi/HTTP gagal hari ini.
      </ui5-message-strip>

    <% } else { %>

      <ui5-table sticky-column-header overflow-mode="Scroll" accessible-name="Today Diagnostics">
        <ui5-table-header-row slot="headerRow">
          <ui5-table-header-cell min-width="max-content">Device</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Sensor Fail</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">WiFi Fail</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">HTTP Fail</ui5-table-header-cell>
          <ui5-table-header-cell min-width="max-content">Total</ui5-table-header-cell>
        </ui5-table-header-row>

        <% diagnosticsToday.slice(0, 5).forEach(row => { %>
          <ui5-table-row>
            <ui5-table-cell>
              <div class="cell-stack">
                <ui5-text class="cell-strong"><%= row.deviceName %></ui5-text>
                <ui5-text class="muted"><%= row.deviceCode %></ui5-text>
              </div>
            </ui5-table-cell>
            <ui5-table-cell><ui5-text><%= row.sensorFailTotal %></ui5-text></ui5-table-cell>
            <ui5-table-cell><ui5-text><%= row.wifiFailTotal %></ui5-text></ui5-table-cell>
            <ui5-table-cell><ui5-text><%= row.httpFailTotal %></ui5-text></ui5-table-cell>
            <ui5-table-cell><ui5-text class="cell-strong"><%= row.total %></ui5-text></ui5-table-cell>
          </ui5-table-row>
        <% }) %>
      </ui5-table>

      <% if (diagnosticsToday.length > 5) { %>
        <div class="toolbar-row">
          <ui5-text class="muted">+<%= diagnosticsToday.length - 5 %> device lain punya kejadian hari ini</ui5-text>
          <span class="toolbar-spacer"></span>
          <ui5-link href="/dashboard/reports/diagnostics">Lihat semua</ui5-link>
        </div>
      <% } %>

    <% } %>
  </div>
</ui5-panel>
