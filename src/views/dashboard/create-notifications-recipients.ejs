<div class="dashboard-page-header"><div><p class="dashboard-page-eyebrow">Notifications</p><h2>Create Notification Recipient</h2><p>Configure where abnormal temperature alerts are delivered.</p></div></div>
<form id="form-create-notification-recipient" class="enterprise-form form-card"><div class="form-card__header"><h3 class="section-title">Recipient Configuration</h3></div><div class="form-card__body"><div class="field-group"><div class="field"><ui5-label for="name" required>Name</ui5-label><ui5-input id="name" name="name" placeholder="e.g. Warehouse Supervisor" required></ui5-input></div><div class="field"><ui5-label for="channel" required>Channel</ui5-label><ui5-select id="channel" name="channel" required><ui5-option value="">Select channel</ui5-option><ui5-option value="email">Email</ui5-option><ui5-option value="whatsapp">WhatsApp</ui5-option></ui5-select></div><div class="field"><ui5-label id="target-label" for="target" required>Target</ui5-label><ui5-input id="target" name="target" placeholder="Select a channel first" required></ui5-input></div><div class="field"><ui5-label for="isActive">Status</ui5-label><ui5-switch id="isActive" name="isActive" checked>Active</ui5-switch></div></div></div><div class="form-card__actions"><a href="/dashboard/notifications-recipients" class="btn btn-outline">Cancel</a><ui5-button type="Submit" design="Emphasized">Save Recipient</ui5-button></div></form>
