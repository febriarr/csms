<form id="form-create-notification-recipient" class="form-card">
  <div class="form-card__header">
    <ui5-title level="H4">Recipient Configuration</ui5-title>
    <ui5-text class="muted">Configure where abnormal temperature alerts are delivered.</ui5-text>
  </div>

  <div class="form-card__body field-group">
    <div class="field">
      <ui5-label for="name" required>Name</ui5-label>
      <ui5-input id="name" name="name" placeholder="e.g. Warehouse Supervisor" required></ui5-input>
    </div>

    <div class="field">
      <ui5-label for="channel" required>Channel</ui5-label>
      <ui5-select id="channel" name="channel" required accessible-name="Channel">
        <ui5-option value="" selected>Select channel</ui5-option>
        <ui5-option value="email">Email</ui5-option>
        <ui5-option value="whatsapp">WhatsApp</ui5-option>
      </ui5-select>
    </div>

    <div class="field">
      <ui5-label id="target-label" for="target" required>Target</ui5-label>
      <ui5-input id="target" name="target" placeholder="Select a channel first" required></ui5-input>
    </div>

    <div class="field">
      <ui5-label for="isActive">Status</ui5-label>
      <div class="switch-row">
        <ui5-switch id="isActive" accessible-name="Active" checked></ui5-switch>
        <ui5-text>Active</ui5-text>
      </div>
    </div>
  </div>

  <div class="form-card__actions">
    <ui5-button design="Transparent" data-href="/dashboard/notifications-recipients">Cancel</ui5-button>
    <ui5-button type="Submit" design="Emphasized">Save Recipient</ui5-button>
  </div>
</form>
