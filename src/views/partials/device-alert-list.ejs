<% if (alerts.length === 0) { %>
  <p class="alert-empty">Belum ada riwayat alert.</p>
<% } else { %>
  <ul class="alert-list">
    <% alerts.forEach(function(alert) { %>
      <li class="alert-item alert-item-<%= alert.toState.toLowerCase() %>">
        <div class="alert-item-header">
          <span class="alert-transition"><%= alert.fromState %> &rarr; <%= alert.toState %></span>
          <span class="alert-time"><%= formatDateTime(alert.occurredAt) %></span>
        </div>
        <div class="alert-reason-code"><%= alert.reasonCode.replaceAll('_', ' ') %></div>
        <% if (alert.reason) { %>
          <p class="alert-reason-text"><%= alert.reason %></p>
        <% } %>
      </li>
    <% }); %>
  </ul>
<% } %>