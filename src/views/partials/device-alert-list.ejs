<% if (alerts.length === 0) { %>
  <ui5-message-strip design="Information" hide-close-button>Belum ada riwayat alert.</ui5-message-strip>
<% } else { %>
  <%
    const stateDesign = { NORMAL: 'Positive', DEFROST: 'Information', WARNING: 'Critical', CRITICAL: 'Negative' };
  %>
  <ui5-list class="alert-list" accessible-name="Alert history">
    <% alerts.forEach(function(alert) { %>
      <ui5-li
        wrapping-type="Normal"
        text="<%= alert.fromState %> → <%= alert.toState %>"
        description="<%= alert.reasonCode.replaceAll('_', ' ') %><%= alert.reason ? ' — ' + alert.reason : '' %>"
        additional-text="<%= formatDateTime(alert.occurredAt) %>"
        additional-text-state="<%= stateDesign[alert.toState] ?? 'None' %>"
      ></ui5-li>
    <% }); %>
  </ui5-list>
<% } %>
