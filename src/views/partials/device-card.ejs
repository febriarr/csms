<%
  const stateDesign = { NORMAL: 'Positive', WARNING: 'Critical', CRITICAL: 'Negative', DEFROST: 'Information' };
  const stateClass = 'status-' + device.state.toLowerCase();
%>
<ui5-card id="device-<%= device.id %>" data-device-id="<%= device.id %>" class="device-card">
  <ui5-card-header slot="header" title-text="<%= device.name %>" subtitle-text="<%= device.location ?? '-' %>">
    <ui5-tag slot="action" class="status-badge <%= stateClass %>" design="<%= stateDesign[device.state] ?? 'Neutral' %>"><%= device.state %></ui5-tag>
  </ui5-card-header>

  <div class="device-card__body">
    <div class="gauge-box <%= stateClass %>">
      <div>
        <ui5-label>Current Temperature</ui5-label>
        <ui5-title level="H2" class="temp-value"><%= device.lastTemperature ?? '--.--' %> °C</ui5-title>
      </div>
      <ui5-icon name="temperature"></ui5-icon>
    </div>

    <div class="device-card__row">
      <ui5-label>State Status</ui5-label>
      <ui5-text class="state-label"><%= stateLabelMap[device.state] %></ui5-text>
    </div>

    <div class="device-card__section">
      <ui5-label>Temperature Threshold</ui5-label>
      <div class="threshold-grid">
        <div class="threshold-item">
          <ui5-label>Defrost</ui5-label>
          <ui5-text><%= device.defrostThreshold %>°C - <%= device.warningThreshold %>°C</ui5-text>
        </div>
        <div class="threshold-item">
          <ui5-label>Warning</ui5-label>
          <ui5-text><%= device.warningThreshold %>°C - <%= device.criticalThreshold %>°C</ui5-text>
        </div>
        <div class="threshold-item">
          <ui5-label>Critical</ui5-label>
          <ui5-text>&gt; <%= device.criticalThreshold %>°C</ui5-text>
        </div>
      </div>
    </div>

    <div class="card-meta">
      <ui5-text>Device <strong class="meta-code"><%= device.code %></strong></ui5-text>
      <ui5-text>Last Seen <strong class="last-seen-label"><%= formatLastSeen(device.lastSeenAt) %></strong></ui5-text>
    </div>

    <ui5-button
      design="Default"
      icon="history"
      class="btn-view-alerts btn-block"
      data-id="<%= device.id %>"
      hx-get="/device/<%= device.id %>/alerts-partial"
      hx-target="#alert-modal-body"
      hx-indicator="#alert-modal-loading"
    >View Alert History</ui5-button>
  </div>
</ui5-card>
