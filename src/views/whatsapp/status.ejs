<ui5-panel header-text="Status WhatsApp Gateway" fixed>
  <div class="stack">
    <ui5-text class="muted">Connection status for outbound alert notifications.</ui5-text>

    <% if (connected) { %>
      <ui5-message-strip design="Positive" hide-close-button>Terhubung</ui5-message-strip>
    <% } else if (qrImage) { %>
      <ui5-text>Scan QR ini pakai WhatsApp:</ui5-text>
      <img src="<%= qrImage %>" alt="QR Code" class="qr-image" />
    <% } else { %>
      <ui5-message-strip design="Information" hide-close-button>Menunggu QR code...</ui5-message-strip>
    <% } %>
  </div>
</ui5-panel>
