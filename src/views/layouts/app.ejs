<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="/build/favicon.png" />
  <title><%= title ?? 'CI-CSMS' %></title>
  <script src="/build/vendor/htmx.min.js" defer></script>
  <%- include('../partials/assets') %>
</head>

<body class="public-shell" data-app-version="<%= appVersion %>" data-page-scripts="<%= JSON.stringify(typeof pageScripts !== 'undefined' ? pageScripts : []) %>">
