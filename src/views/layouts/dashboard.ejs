<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title ?? 'CI-CSMS Dashboard' %></title>
  <link rel="icon" type="image/png" href="/build/favicon.png" />
  <%- include('../partials/assets') %>
</head>

<body class="dashboard-shell" data-app-version="<%= appVersion %>" data-page-scripts="<%= JSON.stringify(typeof pageScripts !== 'undefined' ? pageScripts : []) %>">
  <%- include('../partials/page-loading') %>

  <%
    const navItems = [
      { text: 'Overview', icon: 'home', href: '/dashboard', exact: true },
      { text: 'Devices', icon: 'sys-monitor', href: '/dashboard/devices' },
      { text: 'Notification Recipients', icon: 'bell', href: '/dashboard/notifications-recipients' },
      { text: 'Temperature Reports', icon: 'line-chart', href: '/dashboard/reports/temperature' },
      { text: 'Diagnostics', icon: 'activity-items', href: '/dashboard/reports/diagnostics' },
    ];
    const current = typeof currentPath !== 'undefined' ? currentPath : '';
    const isActive = (item) => item.exact ? current === item.href : current === item.href || current.startsWith(item.href + '/');
  %>

  <ui5-navigation-layout id="dashboard-layout">

    <ui5-bar slot="header" design="Header" class="header-bar">
      <ui5-button
        id="navigation-toggle"
        icon="menu2"
        design="Transparent"
        tooltip="Toggle navigation"
        accessible-name="Toggle navigation"
        slot="startContent"
      ></ui5-button>

      <img slot="startContent" src="/build/logo-stp.webp" alt="STP" class="brand-logo" />

      <ui5-title level="H5" class="header-title">Cold Storage Monitoring System</ui5-title>

      <ui5-button slot="endContent" id="button-documentation" design="Transparent" icon="sys-help" data-href="/dashboard/docs/user-guide">Docs</ui5-button>
      <ui5-button slot="endContent" id="logout-button" design="Transparent" icon="log">Logout</ui5-button>
    </ui5-bar>

    <ui5-side-navigation slot="sideContent">
      <% navItems.forEach(item => { %>
      <ui5-side-navigation-item
        text="<%= item.text %>"
        icon="<%= item.icon %>"
        href="<%= item.href %>"
        <%= isActive(item) ? 'selected' : '' %>
      ></ui5-side-navigation-item>
      <% }) %>
    </ui5-side-navigation>

    <main class="dashboard-content">
      <header class="dashboard-page-header">
        <ui5-title level="H2"><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : 'Dashboard' %></ui5-title>
        <% if (typeof pageDescription !== 'undefined' && pageDescription) { %>
        <ui5-text class="muted"><%= pageDescription %></ui5-text>
        <% } %>
      </header>

      <%- include('../partials/feedback') %>

      <%- body %>
    </main>

  </ui5-navigation-layout>
</body>

</html>
