{
  "name": "ci-csms",
  "version": "1.0.0",
  "description": "project continuous cold storage monitoring system",
  "keywords": [
    "express"
  ],
  "license": "MIT",
  "author": "Febri Ardiansyah",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx watch src/server.ts",
    "dev": "NODE_ENV=development concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build": "tsc && vite build",
    "start": "NODE_ENV=production node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env src/database/seed.ts",
    "db:seed:users": "tsx --env-file=.env src/database/seed-user.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run tests/unit tests/e2e/http-layer.test.ts",
    "postinstall": "tsx src/scripts/copy-assets.ts",
    "build:assets": "tsx src/scripts/copy-assets.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test:e2e": "vitest run tests/e2e",
    "test:all": "vitest run tests/unit tests/integration tests/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run tests/unit --coverage"
  },
  "devDependencies": {
    "@types/alpinejs": "^3.13.11",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-anchor": "^4.0.4",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-full-reload": "^1.2.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.15.12",
    "@ui5/webcomponents": "^2.26.0",
    "@ui5/webcomponents-icons": "^2.26.0",
    "@whiskeysockets/baileys": "^6.7.24",
    "alpinejs": "^3.15.12",
    "apexcharts": "^7.1.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.0.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ejs": "^6.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "helmet": "^8.3.0",
    "htmx.org": "^2.0.10",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "node-cron": "^3.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.4.3"
  }
}
